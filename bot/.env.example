# GL1TCH Telegram bot — copy to .env and fill. NEVER commit .env.
BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to run admin commands.
ADMIN_IDS=
# The main community group/chat ID (negative number for groups).
GROUP_ID=

# --- Holder-gated rank verification (signature-based) ---
# Browser origin of the website allowed to POST signed payloads (enables the
# verification HTTP server). Leave empty to disable verification entirely.
SITE_ORIGIN=https://gl1tchbased.xyz
# Port the verification HTTP endpoint listens on (reverse-proxy this to HTTPS).
VERIFY_PORT=8787
# Solana RPC used to read holder balances (a private RPC is recommended).
SOLANA_RPC=https://api.mainnet-beta.solana.com
# $GL1TCH mint address. Empty until launch — verification resolves everyone to
# Observer while empty (no balance reads happen pre-launch).
CONTRACT_ADDRESS=
# Optional: private chats unlocked per tier, "tierId:chatId" comma-separated.
# Tier ids: observer, infected, bearer, core, ghost. Chat ids are negative.
# Example: GATED_CHATS=infected:-1001234567890,core:-1009876543210
GATED_CHATS=

# --- Verdict anchoring (A3): public values only ---
# The bot stores Rug Radar sweeps, serves proofs (/attest/*) and links anchors by reading the attester's
# public history. The attester's SECRET key never goes here: it lives with the runner (.github/workflows/attest.yml).
ATTESTER_PUBKEY=
# devnet | mainnet-beta (default mainnet-beta)
ATTEST_CLUSTER=
# Optional RPC for reading anchors (defaults to devnet's public RPC, or SOLANA_RPC on mainnet).
ATTEST_RPC=

# --- Daily 20:00 "Signal" agent (auto-posts to X + Telegram) ---
# X (Twitter) OAuth 1.0a user-context keys (developer.x.com). Write access required.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# X mode: auto = post via API (needs API credits) | manual = DM admins ready-to-paste
# text (free, no credits) | off = skip X.
AGENT_X_MODE=auto
# Telegram channel/group the daily post goes to (bot must be admin). Get it with /chatid.
AGENT_CHANNEL_ID=
# IANA timezone + the job runs daily at 20:00 there.
AGENT_TIMEZONE=Europe/Istanbul
# true = preview-only (DMs admins, posts nowhere). Set false to publish for real.
AGENT_DRY_RUN=true
# Anchor date for the "DAY N" counter (YYYY-MM-DD).
AGENT_START_DATE=2026-05-29

# --- X bridge: "🤖 Auto-post" button → local Playwright worker ---
# Shared secret guarding GET /xqueue + POST /xqueue/ack. Set the SAME value here
# (on Railway) and as X_BRIDGE_TOKEN for the local worker. Empty = bridge off
# (no button, endpoints return 401). Requires the verify HTTP server (SITE_ORIGIN set).
X_BRIDGE_TOKEN=

# --- Question answering in groups and DMs (src/assistant) ---
# Groq API key (free tier, console.groq.com/keys). Empty = the bot stays silent on questions, commands keep working.
GROQ_API_KEY=
