[Unit]
Description=GL1TCH website (Next.js standalone)
After=network-online.target
Wants=network-online.target

[Service]
User=gl1tch-site
Group=gl1tch-site
WorkingDirectory=/opt/gl1tch-site/current
EnvironmentFile=/etc/gl1tch-site/settings.env
EnvironmentFile=-/etc/gl1tch-site/secrets.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
# The VM has 1 GB shared with the bot; keep the heap bounded and let swap absorb peaks.
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=3
MemoryHigh=550M
MemoryMax=700M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/gl1tch-site

[Install]
WantedBy=multi-user.target
