# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workspaces (bot / onchain)
bot/node_modules
onchain/node_modules
onchain/keys
**/.env

# playwright workflows — session secrets + scrape output (SENSITIVE: .profiles holds
# logged-in auth cookies for X / Instagram / YouTube / Railway; out/ holds tokens)
**/.profiles/
/e2e/x/.profiles/
/e2e/x/out/
/e2e/social/.profiles/
/e2e/social/out/
/e2e/railway/.profiles/
/e2e/railway/out/
/e2e/higgsfield/.profiles/
/e2e/github/.profiles/
/e2e/github/out/
# grant applications + funding watcher: founder PII and inbox subjects
/e2e/grants/
e2e/railway/out/rw-token.txt

# any node_modules / build caches anywhere in the monorepo
**/node_modules/
**/.next/
**/dist/
**/tsconfig.tsbuildinfo

.vercel
.env*

# verify-listing local artifacts
e2e/verify/.profile*
e2e/verify/out/
audit.json

# Kept out of the public repo: local Claude Code settings (held live API tokens until
# 2026-10-20 — rotate anything that was ever in it), marketing kits, founder playbooks
# and old drafts. They stay on the founder's machine.
.claude/settings.local.json
.claude/scheduled_tasks.lock
/pump-pack/
/archive/
/test-results/
/GL1TCH_Founder_OS_v3.md
/GL1TCH_Claude_Code_Prompt_Pack_v2.md
/GL1TCH_Website_Wireframe_v2.md
/LAUNCH_GUIDE.md
/gl1tch-audit-outreach-kit.md
/gl1tch-buyback-runbook.md
/Claude_Code_AI_Video_Studio_GTX1060.md

# example env files carry no secrets and document setup
!.env.example
!bot/.env.example
