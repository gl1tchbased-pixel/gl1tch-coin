# GL1TCH website: copy to .env.local. Never commit real secrets.
# Everything here is optional for local development: with no values the scanner uses public
# Solana RPCs (publicnode, then mainnet-beta) and the bot-backed counters stay off.

# --- Scanner (server only) ---
# Private Solana RPC for scans, e.g. a Helius URL. Faster and avoids public-RPC 429s.
SCAN_RPC=

# --- Public (bundled into the client: never put a key here) ---
# The browser always uses key-less publicnode for wallet reads (src/lib/wallet/rpc.ts).
# The bot's /verify endpoint for wallet-signed rank checks. Empty disables on-site verification.
NEXT_PUBLIC_BOT_VERIFY_URL=

# --- Bot link (server only): global scan counter, Signal Graph, Watchtower data ---
# Without these, scans still work; counters and deployer history are simply skipped.
SCAN_STATS_URL=
STATS_TOKEN=

# --- Optional ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Rug Radar sweep tuning
RADAR_BATCH=
RADAR_CONCURRENCY=
# Randomness sources (defaults are the public NIST CURBy and drand endpoints)
CURBY_URL=
DRAND_URL=

# The bot has its own example file: bot/.env.example
